    out property <color> window-outer: mode == TengenMode.dark ? #000000e6 : mode == TengenMode.dark-tint ? #000000e6 : #0d12191f;

    // Redondeo, espacio, tamaños y duraciones
    out property <length> radius-button: 8px;
