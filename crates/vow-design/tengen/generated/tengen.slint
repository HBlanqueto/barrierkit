// Generado desde crates/vow-design/tengen (tokens.json, components.json). No editar a mano:
// cambia los JSON y regenera con `nix eval --raw -f crates/vow-design/tengen slint`.
export enum TengenMode { light, dark, dark-tint }

export struct TengenAccent {
    id: string,
    color: color,
    label: string,
}

export global Theme {
    in-out property <TengenMode> mode: TengenMode.light;

    // Colores (por tema)
    out property <color> accent: mode == TengenMode.dark ? #2f6fe4 : mode == TengenMode.dark-tint ? #2f6fe4 : #2f6fe4;
    out property <color> accent-hover: mode == TengenMode.dark ? #2560cf : mode == TengenMode.dark-tint ? #2560cf : #2560cf;
    out property <color> accent-soft: mode == TengenMode.dark ? #1f3358 : mode == TengenMode.dark-tint ? #1f3358 : #1f3358;
    out property <color> accent-strong: mode == TengenMode.dark ? #6aa2ff : mode == TengenMode.dark-tint ? #6aa2ff : #1f53bd;
    out property <color> bg-control: mode == TengenMode.dark ? #3a3a3a : mode == TengenMode.dark-tint ? #38393d : #e3e8ef;
    out property <color> bg-hover: mode == TengenMode.dark ? #444444 : mode == TengenMode.dark-tint ? #424448 : #dde3eb;
    out property <color> bg-raised: mode == TengenMode.dark ? #2b2b2b : mode == TengenMode.dark-tint ? #2a2b2e : #ffffff;
    out property <color> bg-sunken: mode == TengenMode.dark ? #161616 : mode == TengenMode.dark-tint ? #151617 : #e7ebf1;
    out property <color> bg-surface: mode == TengenMode.dark ? #262626 : mode == TengenMode.dark-tint ? #252628 : #ffffff;
    out property <color> bg-window: mode == TengenMode.dark ? #1e1e1e : mode == TengenMode.dark-tint ? #1d1e20 : #f2f4f7;
    out property <color> cyan: mode == TengenMode.dark ? #4fb6e3 : mode == TengenMode.dark-tint ? #4fb6e3 : #0a6f9a;
    out property <color> danger: mode == TengenMode.dark ? #ff6b6b : mode == TengenMode.dark-tint ? #ff6b6b : #cc2f35;
    out property <color> danger-fill: mode == TengenMode.dark ? #d6363b : mode == TengenMode.dark-tint ? #d6363b : #d6363b;
    out property <color> highlight-border: mode == TengenMode.dark ? #ffffff24 : mode == TengenMode.dark-tint ? #ffffff24 : #ffffff24;
    out property <color> highlight-gloss: mode == TengenMode.dark ? #ffffff38 : mode == TengenMode.dark-tint ? #ffffff38 : #ffffff38;
    out property <color> info: mode == TengenMode.dark ? #b18cff : mode == TengenMode.dark-tint ? #b18cff : #7a49c9;
    out property <color> ink: mode == TengenMode.dark ? #dcdcdc : mode == TengenMode.dark-tint ? #dadcdf : #1b2330;
    out property <color> ink-faint: mode == TengenMode.dark ? #6b6b6b : mode == TengenMode.dark-tint ? #696b70 : #8a96a8;
    out property <color> ink-muted: mode == TengenMode.dark ? #9b9b9b : mode == TengenMode.dark-tint ? #999ca3 : #55657e;
    out property <color> ink-strong: mode == TengenMode.dark ? #f5f5f5 : mode == TengenMode.dark-tint ? #f4f5f6 : #0d1219;
    out property <color> knob-shadow: mode == TengenMode.dark ? #0d12194d : mode == TengenMode.dark-tint ? #0d12194d : #0d12194d;
    out property <color> line: mode == TengenMode.dark ? #333333 : mode == TengenMode.dark-tint ? #323336 : #d6dce5;
    out property <color> line-strong: mode == TengenMode.dark ? #747474 : mode == TengenMode.dark-tint ? #73767c : #848fa1;
    out property <color> menubar-title-open: mode == TengenMode.dark ? #ffffff2e : mode == TengenMode.dark-tint ? #ffffff2e : #0d12191f;
    out property <color> on-accent: mode == TengenMode.dark ? #ffffff : mode == TengenMode.dark-tint ? #ffffff : #ffffff;
    out property <color> on-danger: mode == TengenMode.dark ? #ffffff : mode == TengenMode.dark-tint ? #ffffff : #ffffff;
    out property <color> preview-dark-control: mode == TengenMode.dark ? #3a3a3a : mode == TengenMode.dark-tint ? #3a3a3a : #3a3a3a;
    out property <color> preview-dark-sunken: mode == TengenMode.dark ? #161616 : mode == TengenMode.dark-tint ? #161616 : #161616;
    out property <color> preview-dark-window: mode == TengenMode.dark ? #1e1e1e : mode == TengenMode.dark-tint ? #1e1e1e : #1e1e1e;
