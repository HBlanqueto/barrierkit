    out property <length> control-md: 30px;
    out property <length> control-sm: 24px;
    out property <length> sidebar-inset: 8px;
    out property <length> sidebar-radius: 12px;
    out property <length> sidebar-w: 220px;
    out property <length> titlebar-h: 44px;
    out property <length> titlebar-ssd-h: 32px;
    out property <length> toolgroup-h: 34px;
    out property <duration> dur-base: 220ms;
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-slow: 420ms;
    out property <duration> dur-wait-max: 150ms;

    // Tipografía
    out property <string> font-sans: "Geist";
    out property <string> font-mono: "SF Mono Ligaturized";
    out property <string> font-script: "Dancing Script";
    out property <length> text-body-size: 13px;
    out property <length> text-callout-size: 12px;
    out property <length> text-caption-size: 11px;
    out property <length> text-display-size: 28px;
    out property <length> text-greeting-size: 150px;
    out property <length> text-headline-size: 13px;
    out property <length> text-mono-size: 12px;
    out property <length> text-title-1-size: 20px;
    out property <length> text-title-2-size: 15px;
    out property <int> text-body-weight: 400;
    out property <int> text-callout-weight: 400;
    out property <int> text-caption-weight: 500;
    out property <int> text-display-weight: 700;
    out property <int> text-greeting-weight: 600;
    out property <int> text-headline-weight: 600;
    out property <int> text-mono-weight: 400;
    out property <int> text-title-1-weight: 650;
    out property <int> text-title-2-weight: 600;

    // Sombras (Slint admite una por elemento)
    out property <length> shadow-window-offset-y: 18px;
    out property <length> shadow-window-blur: 48px;
    out property <color> shadow-window-color: mode == TengenMode.light ? #0d12192e : #0000008c;
    out property <length> shadow-float-offset-y: 10px;
    out property <length> shadow-float-blur: 28px;
