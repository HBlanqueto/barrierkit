    out property <color> scrim: mode == TengenMode.dark ? #00000080 : mode == TengenMode.dark-tint ? #00000080 : #0d121947;
    out property <color> shadow-float: mode == TengenMode.dark ? #00000066 : mode == TengenMode.dark-tint ? #00000066 : #00000066;
    out property <color> shadow-soft: mode == TengenMode.dark ? #0d12192e : mode == TengenMode.dark-tint ? #0d12192e : #0d12192e;
    out property <color> shell-bar: mode == TengenMode.dark ? #1e1e1ee6 : mode == TengenMode.dark-tint ? #1d1e20e6 : #f2f4f7e6;
    out property <color> sidebar-flat-bg: mode == TengenMode.dark ? #161616 : mode == TengenMode.dark-tint ? #151617 : #e7ebf1;
    out property <color> sidebar-island-bg: mode == TengenMode.dark ? #161616 : mode == TengenMode.dark-tint ? #151617 : #e7ebf1;
    out property <color> sidebar-island-inner: mode == TengenMode.dark ? #ffffff00 : mode == TengenMode.dark-tint ? #ffffff00 : #ffffff00;
    out property <color> sidebar-island-rim: mode == TengenMode.dark ? #ffffff21 : mode == TengenMode.dark-tint ? #ffffff21 : #0d121900;
    out property <color> success: mode == TengenMode.dark ? #5fcf7c : mode == TengenMode.dark-tint ? #5fcf7c : #1a7f37;
    out property <color> sys-blue: mode == TengenMode.dark ? #2f6fe4 : mode == TengenMode.dark-tint ? #2f6fe4 : #2f6fe4;
    out property <color> sys-cyan: mode == TengenMode.dark ? #0f86b8 : mode == TengenMode.dark-tint ? #0f86b8 : #0f86b8;
    out property <color> sys-gray: mode == TengenMode.dark ? #7d828c : mode == TengenMode.dark-tint ? #7d828c : #7d828c;
    out property <color> sys-green: mode == TengenMode.dark ? #28a046 : mode == TengenMode.dark-tint ? #28a046 : #28a046;
    out property <color> sys-orange: mode == TengenMode.dark ? #e8780e : mode == TengenMode.dark-tint ? #e8780e : #e8780e;
    out property <color> sys-purple: mode == TengenMode.dark ? #8e5bd8 : mode == TengenMode.dark-tint ? #8e5bd8 : #8e5bd8;
    out property <color> sys-red: mode == TengenMode.dark ? #d6363b : mode == TengenMode.dark-tint ? #d6363b : #d6363b;
    out property <color> titlebar-bg: mode == TengenMode.dark ? #1e1e1e : mode == TengenMode.dark-tint ? #1d1e20 : #f2f4f7;
    out property <color> titlebar-bg-inactive: mode == TengenMode.dark ? #161616 : mode == TengenMode.dark-tint ? #151617 : #e7ebf1;
    out property <color> titlebar-line: mode == TengenMode.dark ? #333333 : mode == TengenMode.dark-tint ? #323336 : #d6dce5;
    out property <color> titlebar-title: mode == TengenMode.dark ? #f5f5f5 : mode == TengenMode.dark-tint ? #f4f5f6 : #0d1219;
    out property <color> titlebar-title-inactive: mode == TengenMode.dark ? #9b9b9b : mode == TengenMode.dark-tint ? #999ca3 : #55657e;
    out property <color> toolbar-glass-bg: mode == TengenMode.dark ? #3a3a3cd6 : mode == TengenMode.dark-tint ? #393a3ed6 : #ffffffdb;
    out property <color> traffic-close: mode == TengenMode.dark ? #ff5f57 : mode == TengenMode.dark-tint ? #ff5f57 : #ff5f57;
    out property <color> traffic-inactive: mode == TengenMode.dark ? #4e4e50 : mode == TengenMode.dark-tint ? #4e4e50 : #d3d3d5;
    out property <color> traffic-min: mode == TengenMode.dark ? #febc2e : mode == TengenMode.dark-tint ? #febc2e : #febc2e;
    out property <color> traffic-rim: mode == TengenMode.dark ? #00000033 : mode == TengenMode.dark-tint ? #00000033 : #00000033;
    out property <color> traffic-zoom: mode == TengenMode.dark ? #28c840 : mode == TengenMode.dark-tint ? #28c840 : #28c840;
    out property <color> wallpaper-fallback: mode == TengenMode.dark ? #2b3038 : mode == TengenMode.dark-tint ? #2b3038 : #2b3038;
    out property <color> wallpaper-glass: mode == TengenMode.dark ? #ffffff3d : mode == TengenMode.dark-tint ? #ffffff3d : #ffffff3d;
