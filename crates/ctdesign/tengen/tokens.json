  "spring": {
    "damping": 5
  },
  "font": {
    "families": {
      "sans": "Geist, Inter, \"Noto Sans CJK SC\", system-ui, sans-serif",
      "mono": "Geist Mono, monospace"
    },
    "styles": {
      "mono": {
        "family": "mono",
        "size": 13,
        "line-height": 16,
        "weight": 400
      },
      "display": {
        "family": "sans",
        "size": 26,
        "line-height": 32,
        "weight": 700
      },
      "title-1": {
        "family": "sans",
        "size": 22,
        "line-height": 26,
        "weight": 650
      },
      "title-2": {
        "family": "sans",
        "size": 15,
        "line-height": 20,
        "weight": 600
      },
      "headline": {
        "family": "sans",
        "size": 13,
        "line-height": 18,
        "weight": 700
      },
      "body": {
        "family": "sans",
        "size": 13,
        "line-height": 18,
        "weight": 400
      },
      "callout": {
        "family": "sans",
        "size": 12,
        "line-height": 16,
        "weight": 400
      },
      "caption": {
        "family": "sans",
        "size": 11,
        "line-height": 14,
        "weight": 500
      }
    },
    "line-height-scale": 1.3
  },
  "shadow": {
    "theme": {
      "opacity": 0.25
    },
    "slint": {
      "knob": {
        "offset-y": 1,
        "blur": 3,
        "color": "#0d12194d"
      }
    },
    "unfocused": {
      "blur": 0.45,
      "offset": 0.4,
      "opacity": 0.55
    },
    "layers": {
      "light": {
        "ambient": {
          "blur": 48,
          "y-offset": 18,
          "opacity": 0.18,
          "color": "#0d1219"
        },
        "contact": {
          "blur": 12,
          "y-offset": 4,
          "opacity": 0.08,
          "color": "#0d1219"
        }
      },
      "dark": {
        "ambient": {
          "blur": 56,
          "y-offset": 22,
          "opacity": 0.55,
          "color": "#000000"
        },
        "contact": {
          "blur": 16,
          "y-offset": 6,
          "opacity": 0.35,
          "color": "#000000"
        }
      }
    }
