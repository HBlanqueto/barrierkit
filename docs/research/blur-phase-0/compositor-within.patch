+use smithay::backend::renderer::element::Element;
+use smithay::backend::renderer::element::surface::WaylandSurfaceRenderElement;
+
+use std::cell::Cell;
+
+use super::*;
+
+thread_local! {
+    pub(crate) static EXTRA_REACH: Cell<i32> = const { Cell::new(0) };
+}
+
+pub(crate) struct Within {
+    blurred: Option<Blurred>,
+    id: Id,
+}
+
+impl Default for Within {
+    fn default() -> Self {
+        Self {
+            blurred: None,
+            id: Id::new(),
+        }
+    }
+}
+
+type Surfaces = Vec<WaylandSurfaceRenderElement<GlesRenderer>>;
+
+fn flat(elements: Surfaces) -> Vec<OutputRenderElement<GlesRenderer>> {
+    elements.into_iter().map(Into::into).collect()
+}
+
+pub(crate) fn split(
+    blur: &Blur,
+    rounded_clip: &GlesTexProgram,
+    cache: &mut Within,
+    renderer: &mut GlesRenderer,
+    requester: &WlSurface,
+    scale: f64,
+    mut elements: Surfaces,
+) -> Vec<OutputRenderElement<GlesRenderer>> {
+    let own = Id::from_wayland_resource(requester);
+    let Some(at) = elements.iter().position(|element| *element.id() == own) else {
+        return flat(elements);
+    };
+    let Some(region) = blur_region(requester).into_iter().next() else {
+        return flat(elements);
+    };
+    let below = elements.split_off(at + 1);
+    let origin = elements[at].geometry(Scale::from(scale)).loc;
+    let backdrop = backdrop(
+        blur,
+        rounded_clip,
+        cache,
+        renderer,
+        (scale, origin, region),
+        &below,
+    );
+    let mut out = flat(elements);
+    out.extend(backdrop);
+    out.extend(flat(below));
+    out
+}
+
+fn backdrop(
+    blur: &Blur,
+    rounded_clip: &GlesTexProgram,
+    cache: &mut Within,
+    renderer: &mut GlesRenderer,
+    (scale, origin, region): (f64, Point<i32, Physical>, Rectangle<i32, Logical>),
+    below: &Surfaces,
+) -> Option<OutputRenderElement<GlesRenderer>> {
+    let bounds = below
+        .iter()
+        .map(|element| element.geometry(Scale::from(scale)))
+        .reduce(Rectangle::merge)?;
+    let mut dst = physical_rect(region, scale);
+    dst.loc += origin;
+    let kawase = Kawase::reaching(ctdesign::BACKGROUND_BLUR_PASSES, 1.0);
+    let reach = (kawase.offset * (1u32 << kawase.passes) as f32).ceil() as i32 + EXTRA_REACH.get();
+    let source = Rectangle::new(
+        dst.loc - Point::from((reach, reach)),
+        dst.size + Size::from((2 * reach, 2 * reach)),
+    )
+    .intersection(bounds)?;
+    let dst = dst.intersection(source)?;
+    let corner = Point::from((-source.loc.x, -source.loc.y));
+    let relocated: Vec<_> = below
+        .iter()
+        .map(|element| RelocateRenderElement::from_element(element, corner, Relocate::Relative))
+        .collect();
+    render_blurred(
+        &mut cache.blurred,
+        (&blur.down, &blur.up),
+        renderer,
+        (source.size, scale, kawase),
+        &relocated,
+    )?;
+    let blurred = cache.blurred.as_ref()?;
+    let src = Rectangle::<f64, BufferCoords>::new(
+        (
+            f64::from(dst.loc.x - source.loc.x),
+            f64::from(dst.loc.y - source.loc.y),
+        )
+            .into(),
+        (f64::from(dst.size.w), f64::from(dst.size.h)).into(),
+    );
+    let shape = Shape {
+        rect: dst,
+        radius: 0,
+        exponent: ctdesign::CIRCLE_EXPONENT,
+    };
+    Some(
+        RoundedTextureElement::from_texture(
+            blurred.blurred.clone(),
+            cache.id.clone(),
+            blurred.commit,
+            src,
+            dst,
+            shape,
+            rounded_clip.clone(),
+        )
+        .into(),
+    )
+}
+
+#[cfg(test)]
+mod tests;
