+struct Layer {
+    surface: wl_surface::WlSurface,
+    pool: wl_shm_pool::WlShmPool,
+    file: std::fs::File,
+    width: i32,
+    height: i32,
+}
+
+impl Layer {
+    fn new(
+        compositor: &wl_compositor::WlCompositor,
+        shm: &wl_shm::WlShm,
+        qh: &QueueHandle<Probe>,
+        name: &str,
+        (width, height): (i32, i32),
+        scale: i32,
+    ) -> Self {
+        let bytes = (width * height * 4 * 2) as u64;
+        static NEXT: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+        let unique = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let path =
+            std::env::temp_dir().join(format!("blurp0-{}-{unique}-{name}", std::process::id()));
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(&path)
+            .unwrap();
+        file.set_len(bytes).unwrap();
+        std::fs::remove_file(&path).ok();
+        let pool = shm.create_pool(file.as_fd(), bytes as i32, qh, ());
+        let surface = compositor.create_surface(qh, ());
+        surface.set_buffer_scale(scale);
+        Self {
+            surface,
+            pool,
+            file,
+            width,
+            height,
+        }
+    }
+
+    fn attach(&self, frame: u32, pixels: &[u8], qh: &QueueHandle<Probe>) {
+        let offset = (frame % 2) as usize * pixels.len();
+        self.file.write_all_at(pixels, offset as u64).unwrap();
+        let buffer = self.pool.create_buffer(
+            offset as i32,
+            self.width,
+            self.height,
+            self.width * 4,
+            wl_shm::Format::Argb8888,
+            qh,
+            (),
+        );
+        self.surface.attach(Some(&buffer), 0, 0);
+        self.surface.damage_buffer(0, 0, self.width, self.height);
+    }
+}
+
+enum Msg {
+    Ready,
+    Mid(u32),
+    Frame(u32),
+}
+
+fn client(p: Params, socket: UnixStream, to_main: Sender<Msg>, from_main: Receiver<()>) {
+    let connection = Connection::from_socket(socket).unwrap();
+    let (globals, mut queue) = registry_queue_init::<Probe>(&connection).unwrap();
+    let qh = queue.handle();
+    let compositor: wl_compositor::WlCompositor = globals.bind(&qh, 3..=6, ()).unwrap();
+    let subcompositor: wl_subcompositor::WlSubcompositor = globals.bind(&qh, 1..=1, ()).unwrap();
+    let shm: wl_shm::WlShm = globals.bind(&qh, 1..=1, ()).unwrap();
+    let effects: ExtBackgroundEffectManagerV1 = globals.bind(&qh, 1..=1, ()).unwrap();
+    let mut probe = Probe;
+
+    let content = Layer::new(
+        &compositor,
+        &shm,
+        &qh,
+        "content",
+        (p.width * p.scale, p.height * p.scale),
+        p.scale,
+    );
+    let chrome = Layer::new(
+        &compositor,
+        &shm,
+        &qh,
+        "chrome",
+        (p.width * p.scale, p.requester_height() * p.scale),
+        p.scale,
+    );
+    let (root, sub) = match p.layout {
+        Layout::Above => (&content, &chrome),
+        Layout::Below => (&chrome, &content),
+    };
+    let subsurface = subcompositor.get_subsurface(&sub.surface, &root.surface, &qh, ());
+    if p.layout == Layout::Below {
+        subsurface.place_below(&root.surface);
+    }
+    if p.desync {
+        subsurface.set_desync();
+    }
+    let effect = effects.get_background_effect(&chrome.surface, &qh, ());
+    queue.roundtrip(&mut probe).unwrap();
+    to_main.send(Msg::Ready).unwrap();
+    from_main.recv().unwrap();
+
+    for frame in 0..p.frames {
+        content.attach(frame, &content_pixels(&p, frame), &qh);
+        if frame == 0 || p.moving {
+            chrome.attach(frame, &chrome_pixels(&p, frame), &qh);
+        }
+        let region = compositor.create_region(&qh, ());
+        let band = p.band(frame);
+        region.add(
+            0,
+            if p.full { band.loc.y } else { 0 },
+            band.size.w,
+            band.size.h,
+        );
+        effect.set_blur_region(Some(&region));
+        region.destroy();
+
+        sub.surface.commit();
+        queue.roundtrip(&mut probe).unwrap();
+        if frame > 0 {
+            to_main.send(Msg::Mid(frame)).unwrap();
+            from_main.recv().unwrap();
+        }
+        root.surface.commit();
+        queue.roundtrip(&mut probe).unwrap();
+        to_main.send(Msg::Frame(frame)).unwrap();
+        from_main.recv().unwrap();
+    }
+}
+
+fn next(
+    display: &mut smithay::reexports::wayland_server::Display<State>,
+    state: &mut State,
+    from_client: &Receiver<Msg>,
+) -> Msg {
+    let deadline = Instant::now() + Duration::from_secs(180);
+    loop {
+        display.dispatch_clients(state).unwrap();
+        display.flush_clients().unwrap();
+        match from_client.try_recv() {
+            Ok(message) => return message,
+            Err(TryRecvError::Empty) => {
+                assert!(Instant::now() < deadline, "the client stalled");
+                std::thread::sleep(Duration::from_micros(50));
+            }
+            Err(TryRecvError::Disconnected) => panic!("the client died"),
+        }
+    }
+}
+
+fn surfaces_of(handle: &DisplayHandle, client: &Client) -> Vec<WlSurface> {
+    let backend = handle.backend_handle();
+    let mut ids = Vec::new();
+    let _ = backend.with_all_objects_for(client.id(), |id| ids.push(id));
+    ids.into_iter()
+        .filter(|id| {
+            handle
+                .object_info(id.clone())
+                .is_ok_and(|info| info.interface.name == "wl_surface")
+        })
+        .filter_map(|id| WlSurface::from_id(handle, id).ok())
+        .collect()
+}
+
+struct Shot {
+    pixels: Vec<u8>,
+    incremental: Option<(Vec<u8>, i32)>,
+    blur: Duration,
+    baseline: Option<Duration>,
+}
+
+#[allow(unsafe_code)]
+fn finish(renderer: &mut GlesRenderer) {
+    renderer.with_context(|gl| unsafe { gl.Finish() }).unwrap();
+}
+
+struct Persistent {
+    target: GlesTexture,
+    tracker: OutputDamageTracker,
+    size: Size<i32, Physical>,
+    drawn: bool,
+}
+
+impl Persistent {
+    fn new(renderer: &mut GlesRenderer, size: Size<i32, Physical>, scale: f64) -> Self {
+        Self {
+            target: Offscreen::<GlesTexture>::create_buffer(
+                renderer,
+                Fourcc::Abgr8888,
+                Size::<i32, BufferCoords>::from((size.w, size.h)),
+            )
+            .unwrap(),
+            tracker: OutputDamageTracker::new(size, Scale::from(scale), Transform::Normal),
+            size,
+            drawn: false,
+        }
+    }
+
+    fn draw(
+        &mut self,
+        renderer: &mut GlesRenderer,
+        elements: &[OutputRenderElement<GlesRenderer>],
+    ) -> (Vec<u8>, i32) {
+        let age = usize::from(self.drawn);
+        self.drawn = true;
+        let buffer_size = Size::<i32, BufferCoords>::from((self.size.w, self.size.h));
+        let mut framebuffer = renderer.bind(&mut self.target).unwrap();
+        let result = self
+            .tracker
+            .render_output(renderer, &mut framebuffer, age, elements, [0.0; 4])
+            .unwrap();
+        let damaged = result.damage.map_or(0, |rects| {
+            rects.iter().map(|rect| rect.size.w * rect.size.h).sum()
+        });
+        let mapping = renderer
+            .copy_framebuffer(
+                &framebuffer,
+                Rectangle::from_size(buffer_size),
+                Fourcc::Abgr8888,
+            )
+            .unwrap();
+        (renderer.map_texture(&mapping).unwrap().to_vec(), damaged)
+    }
+}
+
+fn read(
+    renderer: &mut GlesRenderer,
+    size: Size<i32, Physical>,
+    scale: f64,
+    elements: &[OutputRenderElement<GlesRenderer>],
+) -> Vec<u8> {
+    Persistent::new(renderer, size, scale)
+        .draw(renderer, elements)
+        .0
+}
+
+struct Rig {
+    renderer: GlesRenderer,
+    blur: Blur,
+    clip: GlesTexProgram,
+}
+
+impl Rig {
+    fn new() -> Option<Self> {
+        let mut renderer = try_test_renderer()?;
+        let blur = compile(&mut renderer).expect("the blur shaders compile");
+        let clip = crate::effects::compile_rounded_clip(&mut renderer).expect("the clip compiles");
+        Some(Self {
+            renderer,
+            blur,
+            clip,
+        })
+    }
+
+    fn tree(&mut self, root: &WlSurface, scale: f64) -> Surfaces {
+        render_elements_from_surface_tree::<GlesRenderer, WaylandSurfaceRenderElement<GlesRenderer>>(
+            &mut self.renderer,
+            root,
+            (0, 0),
+            scale,
+            1.0,
+            Kind::Unspecified,
+        )
+    }
+
+    fn shoot(
+        &mut self,
+        (root, requester): (&WlSurface, &WlSurface),
+        within: &mut Within,
+        p: &Params,
+        with_blur: bool,
+        (full, persistent): (&mut Option<Blurred>, Option<&mut Persistent>),
+    ) -> Shot {
+        let scale = f64::from(p.scale);
+        let elements = self.tree(root, scale);
+        let baseline = p.baseline.then(|| {
+            let kawase = Kawase::reaching(ctdesign::BACKGROUND_BLUR_PASSES, 1.0);
+            let started = Instant::now();
+            render_blurred(
+                full,
+                (&self.blur.down, &self.blur.up),
+                &mut self.renderer,
+                (p.physical(), scale, kawase),
+                &elements,
+            )
+            .unwrap();
+            finish(&mut self.renderer);
+            started.elapsed()
+        });
+        let started = Instant::now();
+        let drawn = if with_blur {
+            split(
+                &self.blur,
+                &self.clip,
+                within,
+                &mut self.renderer,
+                requester,
+                scale,
+                elements,
+            )
+        } else {
+            flat(elements)
+        };
+        finish(&mut self.renderer);
+        let blur = started.elapsed();
+        let pixels = read(&mut self.renderer, p.physical(), scale, &drawn);
+        let incremental = persistent.map(|persistent| persistent.draw(&mut self.renderer, &drawn));
+        Shot {
+            pixels,
+            incremental,
+            blur,
+            baseline,
+        }
+    }
+
+    fn capture(&mut self, root: &WlSurface, p: &Params) -> Vec<u8> {
+        let scale = f64::from(p.scale);
+        let elements = build_window_elements::<GlesRenderer>(&mut self.renderer, root, scale);
+        read(&mut self.renderer, p.physical(), scale, &elements)
+    }
+}
+
+fn pixel(pixels: &[u8], p: &Params, x: i32, y: i32) -> [u8; 4] {
+    let at =
+        ((y * p.scale + p.scale / 2) * p.width * p.scale + x * p.scale + p.scale / 2) as usize * 4;
+    pixels[at..at + 4].try_into().unwrap()
+}
+
+fn close(a: [u8; 4], b: [u8; 4]) -> bool {
+    a.iter().zip(b).all(|(a, b)| a.abs_diff(b) <= 1)
+}
+
+fn outside_mismatches(pixels: &[u8], p: &Params, frame: u32) -> usize {
+    let band = p.band(frame);
+    (0..p.height)
+        .filter(|y| *y < band.loc.y || *y >= band.loc.y + BAND)
+        .filter(|y| !close(pixel(pixels, p, COLUMN, *y), stripe(*y, frame)))
+        .count()
+}
+
+fn band_deviation(pixels: &[u8], p: &Params, frame: u32) -> f64 {
+    let band = p.band(frame);
+    let total: u32 = (band.loc.y..band.loc.y + BAND)
+        .map(|y| u32::from(pixel(pixels, p, COLUMN, y)[0].abs_diff(stripe(y, frame)[0])))
+        .sum();
+    f64::from(total) / f64::from(BAND)
+}
+
+fn mark_sharp(pixels: &[u8], p: &Params, frame: u32) -> bool {
+    let (x, y) = (
+        MARK_X + MARK_WIDTH / 2,
+        p.band_top(frame) + MARK_DROP + MARK_HEIGHT / 2,
+    );
+    close(pixel(pixels, p, x, y), MARK)
+}
+
+fn band_red(pixels: &[u8], p: &Params, frame: u32) -> Vec<f64> {
+    let band = p.band(frame);
+    (band.loc.y..band.loc.y + BAND)
+        .map(|y| f64::from(pixel(pixels, p, COLUMN, y)[0]))
+        .collect()
+}
+
+fn box_blurred_red(p: &Params, rows_of: u32, phase_of: u32) -> Vec<f64> {
+    let band = p.band(rows_of);
+    (band.loc.y..band.loc.y + BAND)
+        .map(|y| {
+            let reach = REACH / p.scale;
+            let sum: f64 = (-reach..=reach)
+                .map(|d| f64::from(stripe((y + d).clamp(0, p.height - 1), phase_of)[0]))
+                .sum();
+            sum / f64::from(2 * reach + 1)
+        })
+        .collect()
+}
+
+fn correlation(a: &[f64], b: &[f64]) -> f64 {
+    let n = a.len() as f64;
+    let (ma, mb) = (a.iter().sum::<f64>() / n, b.iter().sum::<f64>() / n);
+    let (mut ab, mut aa, mut bb) = (0.0, 0.0, 0.0);
+    for (x, y) in a.iter().zip(b) {
+        ab += (x - ma) * (y - mb);
+        aa += (x - ma) * (x - ma);
+        bb += (y - mb) * (y - mb);
+    }
+    ab / (aa.sqrt() * bb.sqrt()).max(1e-9)
+}
+
+fn dump(name: &str, pixels: &[u8], p: &Params) {
+    let Some(dir) = std::env::var_os("BLURP0_FRAMES") else {
+        return;
+    };
+    let path = std::path::Path::new(&dir).join(format!("{name}.png"));
+    let file = BufWriter::new(std::fs::File::create(path).unwrap());
+    let mut encoder = png::Encoder::new(file, p.physical().w as u32, p.physical().h as u32);
+    encoder.set_color(png::ColorType::Rgba);
+    encoder.set_depth(png::BitDepth::Eight);
+    encoder
+        .write_header()
+        .unwrap()
+        .write_image_data(pixels)
+        .unwrap();
+}
