+const BAND: i32 = 96;
+const PERIOD: i32 = 64;
+const REACH: i32 = 24;
+const COLUMN: i32 = 300;
+const MARK_X: i32 = 24;
+const MARK_WIDTH: i32 = 80;
+const MARK_HEIGHT: i32 = 12;
+const MARK_DROP: i32 = 36;
+const STRIPE_A: [u8; 4] = [235, 64, 52, 255];
+const STRIPE_B: [u8; 4] = [38, 70, 210, 255];
+const MARK: [u8; 4] = [40, 200, 80, 255];
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Layout {
+    Above,
+    Below,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Params {
+    layout: Layout,
+    full: bool,
+    moving: bool,
+    desync: bool,
+    scale: i32,
+    width: i32,
+    height: i32,
+    frames: u32,
+    reference: bool,
+    baseline: bool,
+}
+
+impl Params {
+    fn small(layout: Layout) -> Self {
+        Self {
+            layout,
+            full: false,
+            moving: false,
+            desync: false,
+            scale: 1,
+            width: 400,
+            height: 300,
+            frames: 24,
+            reference: true,
+            baseline: false,
+        }
+    }
+
+    fn physical(&self) -> Size<i32, Physical> {
+        Size::from((self.width * self.scale, self.height * self.scale))
+    }
+
+    fn requester_height(&self) -> i32 {
+        if self.full { self.height } else { BAND }
+    }
+
+    fn band_top(&self, frame: u32) -> i32 {
+        if self.moving {
+            (frame as i32 * 9) % (self.height - BAND)
+        } else {
+            0
+        }
+    }
+
+    fn band(&self, frame: u32) -> Rectangle<i32, Logical> {
+        Rectangle::new(
+            Point::from((0, self.band_top(frame))),
+            Size::from((self.width, BAND)),
+        )
+    }
+}
+
+fn phase(frame: u32) -> i32 {
+    (frame as i32 * 7) % PERIOD
+}
+
+fn stripe(y: i32, frame: u32) -> [u8; 4] {
+    if (y + phase(frame)) % PERIOD < PERIOD / 2 {
+        STRIPE_A
+    } else {
+        STRIPE_B
+    }
+}
+
+fn argb(rgba: [u8; 4]) -> [u8; 4] {
+    [rgba[2], rgba[1], rgba[0], rgba[3]]
+}
+
+fn content_pixels(p: &Params, frame: u32) -> Vec<u8> {
+    let width = (p.width * p.scale) as usize;
+    let mut out = Vec::with_capacity(width * (p.height * p.scale) as usize * 4);
+    for y in 0..p.height * p.scale {
+        let row = argb(stripe(y / p.scale, frame));
+        for _ in 0..width {
+            out.extend_from_slice(&row);
+        }
+    }
+    out
+}
+
+fn chrome_pixels(p: &Params, frame: u32) -> Vec<u8> {
+    let width = (p.width * p.scale) as usize;
+    let height = (p.requester_height() * p.scale) as usize;
+    let mut out = vec![0u8; width * height * 4];
+    let top = (p.band_top(frame) + MARK_DROP) * p.scale;
+    for y in top..top + MARK_HEIGHT * p.scale {
+        for x in MARK_X * p.scale..(MARK_X + MARK_WIDTH) * p.scale {
+            let at = (y as usize * width + x as usize) * 4;
+            out[at..at + 4].copy_from_slice(&argb(MARK));
+        }
+    }
+    out
+}
