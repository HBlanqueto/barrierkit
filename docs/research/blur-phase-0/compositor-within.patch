+fn run(p: Params) -> Option<Report> {
+    let mut rig = Rig::new()?;
+    let (_event_loop, mut display, mut state) = test_state((1280, 720));
+    let (client_side, server_side) = UnixStream::pair().unwrap();
+    let (to_main, from_client) = channel::<Msg>();
+    let (ack, from_main) = channel::<()>();
+    let thread = std::thread::spawn(move || client(p, client_side, to_main, from_main));
+    let handle = display.handle();
+    let wl_client = insert_client(&display, server_side);
+
+    assert!(matches!(
+        next(&mut display, &mut state, &from_client),
+        Msg::Ready
+    ));
+    let surfaces = surfaces_of(&handle, &wl_client);
+    assert_eq!(surfaces.len(), 2);
+    let root = surfaces
+        .iter()
+        .find(|surface| get_parent(surface).is_none())
+        .unwrap()
+        .clone();
+    let sub = surfaces
+        .iter()
+        .find(|surface| get_parent(surface).is_some())
+        .unwrap()
+        .clone();
+    let requester = match p.layout {
+        Layout::Above => sub.clone(),
+        Layout::Below => root.clone(),
+    };
+    ack.send(()).unwrap();
+
+    let mut report = Report {
+        renderer_name: renderer_name(&mut rig.renderer),
+        min_deviation: f64::MAX,
+        min_gain: f64::MAX,
+        min_correlation: 1.0,
+        ..Report::default()
+    };
+    let mut within = Within::default();
+    let mut full = None;
+    let mut persistent = Persistent::new(&mut rig.renderer, p.physical(), f64::from(p.scale));
+    let mut previous: Option<Vec<u8>> = None;
+    let mut previous_band = p.band(0);
+    loop {
+        match next(&mut display, &mut state, &from_client) {
+            Msg::Ready => unreachable!(),
+            Msg::Mid(frame) => {
+                let region = blur_region(&requester);
+                let was = previous_band;
+                let now = p.band(frame);
+                let local = |band: Rectangle<i32, Logical>| {
+                    vec![Rectangle::new(
+                        Point::from((0, if p.full { band.loc.y } else { 0 })),
+                        band.size,
+                    )]
+                };
+                if region == local(was) {
+                    report.mid_region_previous += 1;
+                }
+                if region == local(now) && local(now) != local(was) {
+                    report.mid_region_new += 1;
+                }
+                let shot = rig.shoot(
+                    (&root, &requester),
+                    &mut within,
+                    &p,
+                    true,
+                    (&mut full, None),
+                );
+                if previous
+                    .as_ref()
+                    .is_some_and(|before| *before == shot.pixels)
+                {
+                    report.mid_equals_previous += 1;
+                } else {
+                    report.mid_torn += 1;
+                    if frame < 4 {
+                        dump(&format!("{}-mid-{frame}", name_of(&p)), &shot.pixels, &p);
+                    }
+                }
+                ack.send(()).unwrap();
+            }
+            Msg::Frame(frame) => {
+                let shot = rig.shoot(
+                    (&root, &requester),
+                    &mut within,
+                    &p,
+                    true,
+                    (&mut full, Some(&mut persistent)),
+                );
+                report.frames += 1;
+                if let Some((incremental, damaged)) = &shot.incremental {
+                    if *incremental == shot.pixels {
+                        report.incremental_equals_full += 1;
+                    }
+                    report
+                        .damage_fraction
+                        .push(f64::from(*damaged) / f64::from(p.physical().w * p.physical().h));
+                }
+                if frame >= 4 {
+                    report.blur_ms.push(shot.blur.as_secs_f64() * 1e3);
+                    report
+                        .baseline_ms
+                        .extend(shot.baseline.map(|time| time.as_secs_f64() * 1e3));
+                }
+                let local = Rectangle::new(
+                    Point::from((0, if p.full { p.band_top(frame) } else { 0 })),
+                    Size::from((p.width, BAND)),
+                );
+                if blur_region(&requester) == vec![local] {
+                    report.region_after_commit += 1;
+                }
+                report.outside_mismatch += outside_mismatches(&shot.pixels, &p, frame);
+                if mark_sharp(&shot.pixels, &p, frame) {
+                    report.marks_sharp += 1;
+                }
+                report.min_deviation =
+                    report
+                        .min_deviation
+                        .min(band_deviation(&shot.pixels, &p, frame));
+                if p.reference {
+                    let mut fresh = Within::default();
+                    let mut none = None;
+                    let again =
+                        rig.shoot((&root, &requester), &mut fresh, &p, true, (&mut none, None));
+                    if again.pixels == shot.pixels {
+                        report.equals_fresh += 1;
+                    }
+                }
+                let seen = band_red(&shot.pixels, &p, frame);
+                if frame > 0 {
+                    let now = correlation(&seen, &box_blurred_red(&p, frame, frame));
+                    let late = correlation(&seen, &box_blurred_red(&p, frame, frame - 1));
+                    report.min_correlation = report.min_correlation.min(now);
+                    report.min_gain = report.min_gain.min(now - late);
+                }
+                if frame == 3 {
+                    EXTRA_REACH.set(96);
+                    let mut wide = Within::default();
+                    let mut none = None;
+                    let more =
+                        rig.shoot((&root, &requester), &mut wide, &p, true, (&mut none, None));
+                    EXTRA_REACH.set(0);
+                    let band = p.band(frame);
+                    report.seam_max_diff = (band.loc.y..band.loc.y + BAND)
+                        .flat_map(|y| {
+                            let a = pixel(&shot.pixels, &p, COLUMN, y);
+                            let b = pixel(&more.pixels, &p, COLUMN, y);
+                            (0..3).map(move |c| a[c].abs_diff(b[c]))
+                        })
+                        .max()
+                        .unwrap_or(0);
+                    let capture = rig.capture(&root, &p);
+                    report.capture_band_deviation = band_deviation(&capture, &p, frame);
+                    report.screen_band_deviation = band_deviation(&shot.pixels, &p, frame);
+                    dump(&format!("{}-screen-{frame}", name_of(&p)), &shot.pixels, &p);
+                    dump(&format!("{}-capture-{frame}", name_of(&p)), &capture, &p);
+                }
+                if frame < 3 {
+                    dump(&format!("{}-{frame}", name_of(&p)), &shot.pixels, &p);
+                }
+                previous = Some(shot.pixels);
+                previous_band = p.band(frame);
+                ack.send(()).unwrap();
+                if frame + 1 == p.frames {
+                    break;
+                }
+            }
+        }
+    }
+    thread.join().unwrap();
+    Some(report)
+}
+
+fn name_of(p: &Params) -> String {
+    format!(
+        "{:?}-{}-{}{}-{}x",
+        p.layout,
+        if p.full { "full" } else { "strip" },
+        if p.moving { "moving" } else { "fixed" },
+        if p.desync { "-desync" } else { "" },
+        p.scale
+    )
+}
+
+fn median(values: &mut [f64]) -> f64 {
+    values.sort_by(|a, b| a.total_cmp(b));
+    values[values.len() / 2]
+}
+
+fn summary(p: &Params, report: &mut Report) {
+    eprintln!(
+        "BLURP0 {} frames={} outside_mismatch={} marks_sharp={} equals_fresh={} incremental_age1_equals_full_repaint={} median_damage_fraction={:.3} \
+         min_band_deviation={:.1} min_corr_now={:.4} min_corr_gain_over_previous={:.4} \
+         mid_equals_previous={} mid_torn={} mid_region_previous={} mid_region_new={} \
+         region_after_parent_commit={} seam_max_channel_diff_vs_96px_wider_source={}",
+        name_of(p),
+        report.frames,
+        report.outside_mismatch,
+        report.marks_sharp,
+        report.equals_fresh,
+        report.incremental_equals_full,
+        median(&mut report.damage_fraction),
+        report.min_deviation,
+        report.min_correlation,
+        report.min_gain,
+        report.mid_equals_previous,
+        report.mid_torn,
+        report.mid_region_previous,
+        report.mid_region_new,
+        report.region_after_commit,
+        report.seam_max_diff,
+    );
+}
+
+fn assert_follows_the_scroll(report: &Report) {
+    let frames = report.frames;
+    assert_eq!(
+        report.outside_mismatch, 0,
+        "rows outside the band are sharp and current"
+    );
+    assert_eq!(
+        report.marks_sharp, frames,
+        "chrome above the blur stays sharp"
+    );
+    assert_eq!(
+        report.equals_fresh, frames,
+        "caches never serve a stale blur"
+    );
+    assert_eq!(
+        report.incremental_equals_full, frames,
+        "output damage tracking with buffer age 1 equals a full repaint"
+    );
+    assert!(report.min_deviation > 8.0, "the band is blurred, not sharp");
+    assert!(
+        report.min_correlation > 0.7,
+        "the band matches the CPU blur of this frame"
+    );
+    assert!(
+        report.min_gain > 0.0,
+        "the band is not the blur of the previous frame"
+    );
+    assert_eq!(
+        report.mid_equals_previous,
+        frames - 1,
+        "a sync sub-surface shows nothing new before the parent commits"
+    );
+    assert_eq!(
+        report.mid_region_new, 0,
+        "the new region is not current before the parent commit"
+    );
+    assert_eq!(
+        report.region_after_commit, frames,
+        "the region is current after the parent commit"
+    );
+}
+
+#[test]
+fn above_the_parent_the_blur_follows_the_scroll_without_lag_at_1x() {
+    let p = Params::small(Layout::Above);
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+}
+
+#[test]
+fn above_the_parent_the_blur_follows_the_scroll_without_lag_at_2x() {
+    let p = Params {
+        scale: 2,
+        ..Params::small(Layout::Above)
+    };
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+}
+
+#[test]
+fn above_the_parent_a_moving_band_and_the_scroll_change_in_one_frame() {
+    let p = Params {
+        full: true,
+        moving: true,
+        ..Params::small(Layout::Above)
+    };
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+    assert!(report.mid_region_previous > 0);
+}
+
+#[test]
+fn below_the_parent_the_blur_follows_the_scroll_without_lag_at_1x() {
+    let p = Params::small(Layout::Below);
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+}
+
+#[test]
+fn below_the_parent_the_blur_follows_the_scroll_without_lag_at_2x() {
+    let p = Params {
+        scale: 2,
+        ..Params::small(Layout::Below)
+    };
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+}
+
+#[test]
+fn below_the_parent_a_moving_band_and_the_scroll_change_in_one_frame() {
+    let p = Params {
+        full: true,
+        moving: true,
+        ..Params::small(Layout::Below)
+    };
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert_follows_the_scroll(&report);
+}
+
+#[test]
+fn a_desynchronized_sub_surface_tears_the_band_and_the_content_apart() {
+    let p = Params {
+        full: true,
+        moving: true,
+        desync: true,
+        ..Params::small(Layout::Above)
+    };
+    let Some(mut report) = run(p) else { return };
+    summary(&p, &mut report);
+    assert!(
+        report.mid_region_new > 0,
+        "desync applies the region before the parent commit"
+    );
+    assert!(
+        report.mid_torn > 0,
+        "desync shows a frame whose band and content disagree"
+    );
+}
+
+#[test]
+fn the_window_capture_path_has_no_blur_and_the_split_path_has_it() {
+    let p = Params::small(Layout::Above);
+    let Some(mut report) = run(p) else { return };
+    eprintln!(
+        "BLURP0 capture band deviation from sharp: build_window_elements={:.1} split={:.1}",
+        report.capture_band_deviation, report.screen_band_deviation
+    );
+    summary(&p, &mut report);
+    assert!(report.capture_band_deviation < 1.0);
+    assert!(report.screen_band_deviation > 8.0);
+}
+
+fn timing(scale: i32) {
+    let p = Params {
+        scale,
+        width: 1280,
+        height: 800,
+        frames: 44,
+        reference: false,
+        baseline: true,
+        ..Params::small(Layout::Above)
+    };
+    let Some(mut report) = run(p) else {
+        eprintln!("BLURP0 TIMING skipped: no EGL device, nothing was measured");
+        return;
+    };
+    let (mut blur, mut full) = (report.blur_ms.clone(), report.baseline_ms.clone());
+    let band = median(&mut blur);
+    eprintln!(
+        "BLURP0 TIMING renderer {}: {}x window {}x{} logical, band {} logical rows: \
+         band blur pass median {:.2} ms (min {:.2}, max {:.2}) over {} frames, \
+         {:.1} % of a 60 Hz frame (16.67 ms) and {:.1} % of a 120 Hz frame (8.33 ms); \
+         full-output Kawase of the same content (the shipping wallpaper pass) median {:.2} ms",
+        report.renderer_name,
+        scale,
+        p.width,
+        p.height,
+        BAND,
+        band,
+        blur.first().copied().unwrap_or_default(),
+        blur.last().copied().unwrap_or_default(),
+        blur.len(),
+        band / (1000.0 / 60.0) * 100.0,
+        band / (1000.0 / 120.0) * 100.0,
+        median(&mut full),
+    );
+    summary(&p, &mut report);
+}
+
+#[test]
+fn the_band_blur_pass_costs_this_much_in_software_at_1x() {
+    timing(1);
+}
+
+#[test]
+fn the_band_blur_pass_costs_this_much_in_software_at_2x() {
+    timing(2);
+}
